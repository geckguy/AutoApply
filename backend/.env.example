# AI Provider: "gemini" (default), "openrouter" or "opencode"
AI_PROVIDER=gemini

# Default: Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# To use OpenRouter instead, set AI_PROVIDER=openrouter and add a key from
# https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Required with OpenRouter. This paid model is used instead of a data-collecting
# free endpoint because AutoApply prompts contain resume/profile information.
# With no model set, AI requests answer 503 with this reason instead of failing
# silently; the dashboard, popup, and /api/health all show the same message.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# "strict" requests no provider data collection and zero data retention.
OPENROUTER_PRIVACY_MODE=strict

# To use OpenCode Go instead (https://opencode.ai/docs/go), set
# AI_PROVIDER=opencode and paste the key from https://opencode.ai/auth.
# It is an OpenAI-compatible subscription gateway that serves many open models
# behind one key; AutoApply identifies itself and sends a stable session id
# (x-opencode-session) as the gateway requires.
OPENCODE_API_KEY=your_opencode_api_key_here
# Required with OpenCode Go. Pick any id from
#   curl -H "Authorization: Bearer $OPENCODE_API_KEY" https://opencode.ai/zen/go/v1/models
# for example deepseek-v4.1-flash, deepseek-v4-pro, glm-5.3, kimi-k2.7-code.
# With no model set, AI requests answer 503 with this reason instead of failing
# silently.
OPENCODE_MODEL=deepseek-v4.1-flash
# Optional: point at a different gateway or pin the session id.
#OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
#OPENCODE_SESSION_ID=

# ---------------------------------------------------------------------------
# Local server and trust model (optional)
# ---------------------------------------------------------------------------
# Backend address. Defaults to loopback only; the process is not reachable from
# other machines unless AUTOAPPLY_HOST is changed deliberately.
AUTOAPPLY_HOST=127.0.0.1
AUTOAPPLY_PORT=8000

# The API has no credentials, so it accepts:
#   * Host: loopback only — localhost, 127.0.0.1, [::1], any port.
#   * Origin: the dashboard's own origin — loopback host and the same port the
#     request arrived on — or an installed AutoApply extension id. A page on a
#     different local port is rejected.
# Requests without an Origin header are accepted (local CLI/processes); the
# Host check above is what blocks DNS rebinding.
#
# AUTOAPPLY_ALLOWED_HOSTS: extra comma-separated Host names to accept on top of
#   the loopback defaults (for example a reverse-proxy hostname).
# AUTOAPPLY_ALLOWED_ORIGINS: extra comma-separated exact origins to accept on
#   top of the dashboard's same-origin rule (for example a reverse-proxied or
#   https origin).
# AUTOAPPLY_EXTENSION_IDS: extra comma-separated extension ids to trust on top
#   of the pinned AutoApply ids (autoapply@local, the published Chrome id).
#AUTOAPPLY_ALLOWED_HOSTS=
#AUTOAPPLY_ALLOWED_ORIGINS=
#AUTOAPPLY_EXTENSION_IDS=
#
# The extension reaches any loopback port: set the Backend field in the
# extension popup (stored as browser.storage.local "autoapplyApiBase") to point
# it at a server started with a non-default AUTOAPPLY_PORT. AUTOAPPLY_PORT is
# also the port whose origin the backend advertises in CORS response headers,
# so set it (not just uvicorn's --port) when opening the dashboard on a
# non-default port from another page.
