# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
env/
.venv/

# Environment
.env
*.env.local

# User data: profile, resume, answers, application history, SQLite database,
# generated resume versions, and the temp files the atomic writers leave behind
# if the process dies mid-write. Everything under backend/data/ is private;
# .gitkeep only exists so the empty directory can be committed.
backend/data/*
!backend/data/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Extension build artifacts
extension/web-ext-artifacts/

# Python bytecode (explicit)
*.pyc
